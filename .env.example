NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/coworking_db
JWT_SECRET=your-super-secret-jwt-key-change-in-production
BCRYPT_ROUNDS=10
LOG_LEVEL=info

# Contenedor (compose.yaml)
POSTGRES_PASSWORD=coworking

# HU-12: simulador/demo y limitación de tasa
ENABLE_SIMULATOR=false
DEMO_ADMIN_PASSWORD=Admin1234!
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# HU-13: hilos y métricas de ejecución
# auto = un worker thread por núcleo lógico (cuenta hyperthreading); 0 = bcrypt sobre libuv
WORKER_THREADS=auto
# Monitor de recursos en /monitor/ y GET /metrics/runtime (fuera de /api, sin rate limit)
ENABLE_METRICS=false

# Demo: el rate limit toma la IP de X-Forwarded-For (solo detrás de un proxy de confianza)
TRUST_PROXY=false

# Servicio "sim" del compose: duración, sesiones por segundo y usuarios virtuales
SIM_DURACION=3m
SIM_RPS=10
SIM_USUARIOS=25
# Una IP por usuario virtual (requiere TRUST_PROXY=true)
SIM_IPS_VIRTUALES=true
