// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  name      String
  password  String
  role      Role    @default(USER)
  balance   Float   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  reservations Reservation[]
  
  @@map("users")
}

model Room {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  capacity    Int
  hourlyRate  Float
  available   Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  reservations Reservation[]
  
  @@map("rooms")
}

model Reservation {
  id        Int     @id @default(autoincrement())
  userId    Int
  roomId    Int
  startDate DateTime
  endDate   DateTime
  status    ReservationStatus @default(PENDING)
  totalCost Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  idempotencyKey IdempotencyKey?

  @@unique([roomId, startDate, endDate])
  // Índices creados en 001_init (HU-07): consultas por usuario, sala y estado.
  @@index([userId])
  @@index([roomId])
  @@index([status])
  @@map("reservations")
}

/**
 * HU-11 (Unidad 5, Actividad B): una misma X-Idempotency-Key nunca debe
 * generar dos reservas. `key` es la clave que envía el cliente; `reservationId`
 * apunta a la reserva que se creó la primera vez que se vio esa clave.
 */
model IdempotencyKey {
  key           String   @id
  reservationId Int      @unique
  createdAt     DateTime @default(now())

  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("idempotency_keys")
}

/**
 * HU-11 (Unidad 5, Actividad C): lista negra de tokens revocados por logout.
 * Se guarda el jti (no el token completo) y su expiración natural, para
 * poder purgar filas vencidas sin tener que decodificar el JWT de nuevo.
 */
model RevokedToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("revoked_tokens")
}

enum Role {
  USER
  ADMIN
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  CANCELLED
  COMPLETED
}
